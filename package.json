{
  "name": "dsh-browser",
  "version": "0.1.0",
  "description": "Browser control for DeepSeek Harness: a /browser command plus browser_* tools over CDP (Chrome by default).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "tsdown": "*",
    "typescript": "*"
  },
  "license": "MIT"
}
