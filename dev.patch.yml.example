# Dev overlay: load the built plugin from source without installing a bundle.
# Copy to dev.patch.yml (gitignored) and set the absolute path of THIS
# checkout — the loader does not rebase patch paths.
# Build first: `pnpm build` (and `node --env-file=.env scripts/link-dev.mjs`
# so the plugin's @deepseek-ai/* and playwright-core imports resolve).
#
# Usage from the harness checkout:
#   pnpm dsh web --patch /path/to/deepseek-chrome/dev.patch.yml
- insert:
    - id: chrome
      name: /path/to/deepseek-chrome/lib/index.js
      config:
        channel: chrome
        headless: false
