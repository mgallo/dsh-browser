# Copy to .env and set the absolute checkout paths for this machine.
# Consumed by AGENTS.md-driven agents (`source .env`) and by
# `node --env-file=.env scripts/link-dev.mjs`.

# Absolute path of THIS plugin checkout (the repo root).
DSH_CHROME_CHECKOUT=/path/to/deepseek-chrome
# Absolute path of a deepseek-harness checkout (typecheck/build deps,
# read-only API reference).
DSH_HARNESS_CHECKOUT=/path/to/deepseek-harness
